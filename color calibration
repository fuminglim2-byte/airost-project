#include <Wire.h>
#include "Adafruit_TCS34725.h"

// Create TCS34725 sensor object
Adafruit_TCS34725 tcs = Adafruit_TCS34725(
  TCS34725_INTEGRATIONTIME_50MS,
  TCS34725_GAIN_4X
);

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  Serial.println("TCS34725 RGB Test");

  if (tcs.begin()) {
    Serial.println("TCS34725 detected!");
  } else {
    Serial.println("TCS34725 NOT detected!");
    while (1) {
      delay(100);
    }
  }
}

void loop() {
  uint16_t red, green, blue, clear;

  tcs.getRawData(&red, &green, &blue, &clear);

  Serial.print("Red: ");
  Serial.print(red);

  Serial.print(" | Green: ");
  Serial.print(green);

  Serial.print(" | Blue: ");
  Serial.print(blue);

  Serial.print(" | Clear: ");
  Serial.println(clear);

  delay(500);
}
